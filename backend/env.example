NODE_ENV=development
PORT=3000
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_COOKIE_MAX_AGE=900000
TMDB_API_KEY=your_tmdb_api_key
TMDB_LANGUAGE=it-IT
TMDB_TIMEOUT_MS=8000
LIBRETRANSLATE_URL=http://localhost:5000
FRONTEND_ORIGIN=http://localhost:5500
RL_AUTH_MAX=10
RL_AUTH_WINDOW_MS=900000
RL_API_MAX=200
RL_API_WINDOW_MS=900000
RL_ADMIN_MAX=50
RL_ADMIN_WINDOW_MS=900000
CACHE_TTL_MS=300000
TRANSLATION_MAX_CHARS=2000
TRANSLATION_BATCH_MAX=20

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_your_api_key
MAIL_FROM=ELI6 Movies <noreply@yourdomain.com>
APP_URL=https://eli6movies.vercel.app

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Set BACKEND_URL to the public origin of the Render backend; the redirect URI
# defaults to ${BACKEND_URL}/api/auth/google/callback. Add that exact URL to
# the Google OAuth client's Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
BACKEND_URL=https://eli6movies.onrender.com

# Geolocation — ip-api.com pro key for HTTPS (optional; free tier falls back
# to empty geo via the existing circuit breaker).
IPAPI_KEY=

# Error reporting — Sentry. Leave blank to disable (Sentry SDK is no-op).
SENTRY_DSN=
SENTRY_TRACES_RATE=0.1
