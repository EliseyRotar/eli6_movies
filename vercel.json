{
  "version": 2,
  "outputDirectory": "frontend",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "experimentalServices": {
    "eli6-movies-api": {
      "type": "web",
      "root": "backend",
      "entrypoint": "server.js",
      "routePrefix": "/api",
      "buildCommand": "npm install"
    }
  }
}
