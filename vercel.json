{
  "version": 2,
  "outputDirectory": "frontend",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/live.html", "destination": "/sport.html", "permanent": true },
    { "source": "/live", "destination": "/sport.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
